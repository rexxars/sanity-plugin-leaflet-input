{
  "name": "sanity-plugin-leaflet-input",
  "version": "2.0.0",
  "description": "Leaflet geopoint input for Sanity Studio",
  "keywords": [
    "geopoint",
    "leaflet",
    "map",
    "sanity",
    "sanity-input-component",
    "sanity-plugin"
  ],
  "license": "MIT",
  "author": "Espen Hovlandsdal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rexxars/sanity-plugin-leaflet-input.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run pack:check",
    "dev": "sanity dev",
    "format": "oxfmt",
    "lint": "oxlint .",
    "pack:check": "publint",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/ui": "^4.0.7",
    "leaflet": "^1.9.4",
    "leaflet-control-geocoder": "^4.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.11.0",
    "styled-components": "^6.5.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2",
    "sanity": "^5 || ^6.0.0-0"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
